{
  "name": "ilearnassist",
  "private": true,
  "type": "module",
  "version": "0.1.2",
  "description": "A self-hosted learning assistant (B/S architecture): workspaces, conversations, a widget side panel, file and document handling, and an agent loop over LangChain.js.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/waychan23/ilearnassist.git"
  },
  "homepage": "https://github.com/waychan23/ilearnassist",
  "bugs": "https://github.com/waychan23/ilearnassist/issues",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @ilearnassist/server --filter @ilearnassist/web dev",
    "dev:server": "pnpm --filter @ilearnassist/server dev",
    "dev:web": "pnpm --filter @ilearnassist/web dev",
    "dev:restart": "bash scripts/dev.sh",
    "dev:stop": "bash scripts/dev.sh --stop",
    "dev:status": "bash scripts/dev.sh --status",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm --filter @ilearnassist/desktop bundle && playwright test",
    "build": "pnpm --filter @ilearnassist/web build",
    "desktop:dev": "pnpm --filter @ilearnassist/desktop dev",
    "desktop:build": "pnpm --filter @ilearnassist/desktop build",
    "desktop:package": "pnpm --filter @ilearnassist/desktop package",
    "desktop:package:mac": "pnpm --filter @ilearnassist/desktop package:mac",
    "desktop:package:win": "pnpm --filter @ilearnassist/desktop package:win",
    "desktop:package:linux": "pnpm --filter @ilearnassist/desktop package:linux"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.2",
    "@vitest/coverage-v8": "5.0.0",
    "typescript": "^5.9.3",
    "vitest": "5.0.0"
  }
}
