{
  "name": "@ilearnassist/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Desktop control panel: starts the ilearnassist server and opens the app.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/waychan23/ilearnassist.git",
    "directory": "apps/desktop"
  },
  "homepage": "https://github.com/waychan23/ilearnassist",
  "bugs": "https://github.com/waychan23/ilearnassist/issues",
  "main": "dist/main/main.cjs",
  "scripts": {
    "dev": "node scripts/build.mjs --no-web && electron .",
    "build": "node scripts/build.mjs",
    "bundle": "node scripts/build.mjs --no-web",
    "icon": "node scripts/make-icon.mjs",
    "package": "node scripts/build.mjs && electron-builder --mac",
    "package:mac": "node scripts/build.mjs && electron-builder --mac --arm64 --x64",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "pdfjs-dist": "^4.10.38",
    "@ilearnassist/shared": "workspace:*"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "jsqr": "^1.4.0",
    "qrcode-generator": "^2.0.4"
  }
}
