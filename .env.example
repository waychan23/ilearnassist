# Copy this file to `.env` and fill in the keys you need.
# The server reads `.env` from the project root on startup; real shell
# environment variables take precedence over this file.

# Where the data lives: the sqlite database, every account's workspaces, and the
# files they upload. REQUIRED — there is no default, and the server refuses to
# start without it. That is deliberate: this path decides how much of your work
# survives an uninstall, so the code will not guess one.
#
# Put it somewhere outside the checkout and outside the application bundle, and
# somewhere you back up.
#
# A relative path resolves against the *project root*, not the working directory —
# `pnpm dev` runs the server with its cwd set to `apps/server`, so "relative to cwd"
# would mean something different from one launcher to the next.
#
# For a checkout, this line is all you need. The desktop app asks instead, and
# passes an absolute path down — see docs/desktop.md.
ILA_DATA_DIR=./data

# A fresh data folder has no administrator, and the server refuses to start
# until one exists. In the desktop app the control panel creates it. From a
# terminal, run once, before `pnpm dev`:
#
#   pnpm --filter @ilearnassist/server cli create-admin --username <you> --generate
#
# `--generate` prints a password once (only its hash is stored). To type your
# own, use `--password-stdin`. `pnpm --filter @ilearnassist/server cli status`
# reports whether an administrator exists. See docs/desktop.md.

# DeepSeek (OpenAI-compatible) — https://platform.deepseek.com
DEEPSEEK_API_KEY=

# OpenAI — https://platform.openai.com
OPENAI_API_KEY=

# Tavily (only needed if tools.webSearch.provider = tavily)
TAVILY_API_KEY=

# Thread classification (脉络梳理) — may the out-of-band classifier call use a
# reasoning model's chain-of-thought? Default `auto`: a model configured with
# the reasoning capability thinks (DeepSeek V4 defaults thinking ON), other
# models never do. `off` sends thinking:{"type":"disabled"} on the wire for the
# classifier call only (DeepSeek / Ark shape) — a tiny JSON task does not need
# the long, slow thinking run; `on` forces it. Also accepts true/false, 1/0,
# enabled/disabled. An unrecognised value stops the server at boot.
# ILA_THREAD_REASONING=auto

# Insight pass (思考总结) — the same three values for the panel's on-demand
# reflection over the conversation's plan, quizzes, threads, notes and diagrams.
# Its own variable rather than a share of the one above: each changes its own
# call alone, and a classification is a judgement while a reflection pass is the
# kind of thinking that benefits from time. Note the default is still `auto`, so
# leaving this unset does not mean "no thinking" — it means "whatever the model
# record says".
# ILA_INSIGHT_REASONING=auto

# Note export (同步到资料库) — the same three values for the summary call the
# export runs over a conversation before writing its notes into the library.
# Its own variable for the reason above, and this is the third call rather than
# a share of either: it is arguably the one that wants thinking least, since it
# is describing material it was handed in full rather than judging or reflecting
# on it. Set it to `off` if your provider bills for reasoning tokens.
# ILA_NOTE_SYNC_REASONING=auto