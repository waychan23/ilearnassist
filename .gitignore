# dependencies
node_modules/

# builds
dist/
build/
*.tsbuildinfo

# the desktop app's packaged output (the .dmg and the unpacked .app)
release/

# runtime data (workspaces, sqlite db, logs)
workspaces/
data/

# scratch space for the e2e run (its own sqlite db + workspaces)
.e2e/
test-results/
playwright-report/
coverage/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# config secrets (keep the example tracked; real keys stay local)
config/config.local.yaml

# env
.env
.env.local
.env.*.local

# editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.log

# Claude Code — per-machine state, none of it shared. The permission grants are whatever this
# clone happened to approve, and worktrees are scratch. The skills are third-party tooling
# installed into this machine, and `skills-lock.json` is what records where each came from:
# they are not this repository's work, so publishing it would redistribute somebody else's.
# Nothing in the product reads any of this.
.claude/settings.local.json
.claude/worktrees/
.claude/skills/
skills-lock.json